{
  "_comment": "Template file. Copy to data.json and add your API keys — or set useEnvironmentVariables to true and leave the key fields empty (then provide YTC_* env vars). Keys and types mirror DEFAULT_SETTINGS in src/main.ts; modelOptionsCache / modelCacheTimestamps are written by the plugin at runtime and need no entry here.",
  "geminiApiKey": "your-gemini-api-key-here",
  "groqApiKey": "your-groq-api-key-here",
  "ollamaApiKey": "your-ollama-api-key-here",
